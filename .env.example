# Copy to .env. Never commit .env or credentials.
# Three Cloudflare Tunnel hostnames, all pointing at Caddy (see README):
# admin apps at MEDIA_DOMAIN/sonarr, /radarr, /prowlarr, /bazarr, /downloads, /admin (behind your login),
MEDIA_DOMAIN=media.example.com
# Jellyfin and Jellyseerr with their own login, so TV and phone apps can connect.
JELLYFIN_DOMAIN=jf.example.com
REQUESTS_DOMAIN=requests.example.com
TZ=Europe/Luxembourg
PUID=1000
PGID=1000
# Jellyfin stays on the LAN, outside Surfshark. Change to the server's LAN IP for TV apps.
JELLYFIN_BIND_IP=127.0.0.1
# Where your cloudflared reaches Caddy (port 80). Use the server's LAN IP if
# cloudflared runs on another machine.
CADDY_BIND_IP=127.0.0.1
# Surfshark credentials and country are set on the admin page (/admin); this is the default country.
VPN_COUNTRIES=Netherlands
# Optional webhook for health alerts; leave empty to log alerts locally.
ALERT_WEBHOOK=
