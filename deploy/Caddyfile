{
    # Cloudflare Tunnel terminates HTTPS; trust its X-Forwarded-Proto so Authelia sees https.
    servers {
        trusted_proxies static private_ranges
    }
}
(headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options SAMEORIGIN
    }
}
(protected) {
    # Never accept identity headers supplied by the browser.
    request_header -Remote-User
    request_header -Remote-Groups
    request_header -Remote-Email
    request_header -Remote-Name
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
}
http://auth.{$MEDIA_DOMAIN} {
    import headers
    reverse_proxy authelia:9091
}
http://{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy portal:8090
}
http://jellyfin.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy jellyfin:8096
}
http://sonarr.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy sonarr:8989
}
http://radarr.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy radarr:7878
}
http://prowlarr.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy prowlarr:9696
}
http://bazarr.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy bazarr:6767
}
http://requests.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy jellyseerr:5055
}
http://downloads.{$MEDIA_DOMAIN} {
    import headers
    import protected
    reverse_proxy gluetun:8080
}
